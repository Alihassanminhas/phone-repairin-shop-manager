NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
RATE_LIMIT_HASH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
BOOTSTRAP_CODE=replace-with-a-one-time-random-code-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=
TRUST_PROXY_HOPS=0
EXPO_PUBLIC_API_URL=https://your-api.example.com
